# H2 Database Configuration (File-based)
# For Docker: jdbc:h2:file:/data/gpusharing;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
# For local: jdbc:h2:file:./data/gpusharing;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DATABASE_URL=jdbc:h2:file:./data/gpusharing;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DATABASE_USER=sa
DATABASE_PW=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRE_HOURS=24
JWT_SECRET_FILE=/tmp/cloudgpu_jwt_secret

# External Services
RELAY_SERVER_URL=http://localhost:5000
WORKER_API_PORT=5000

# Ports
PORT_BACKEND=8001
PORT_RELAY=5000
PORT_WORKER_API=5000
PORT_FRONTEND=3000

# CORS Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173
